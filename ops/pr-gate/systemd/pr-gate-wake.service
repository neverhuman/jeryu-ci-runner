# Start idle gate slots when a gated head appears or moves; see bin/pr-gate-wake.sh. Long-polls the
# forge's gate-wanted signal, or reads the open-PR lists, the merge queue and the pending re-gates
# when the forge has no signal. Never takes a gate lock or posts a status.
[Unit]
Description=Wake idle PR gate runner slots on new or moved heads

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=GATE_RUNNER_HOME=%h/gate-runner
ExecStart=%h/gate-runner/bin/pr-gate-wake.sh
TimeoutStartSec=2min
