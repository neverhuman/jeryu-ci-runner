# 1s after the last look finished. A look is one long-polled `gate-wanted` request that the forge
# holds open until a head appears, so this is near-continuous and still cheaper than one idle slot
# tick. Against a forge with no signal it does nothing (the 404 is cached) and the slot timers carry
# the work; a 429 backs it off with every other slot.
[Unit]
Description=Wait for the forge's gate-wanted signal and wake an idle PR gate slot

[Timer]
OnBootSec=2min
OnUnitInactiveSec=1s
AccuracySec=1s

[Install]
WantedBy=timers.target
