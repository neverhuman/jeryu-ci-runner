# Keep grype's vulnerability database current outside the gates; see bin/pr-gate-grype-db-refresh.sh.
[Unit]
Description=Refresh the grype vulnerability database used by gate recipes

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/gate-runner/bin/pr-gate-grype-db-refresh.sh
TimeoutStartSec=25min
