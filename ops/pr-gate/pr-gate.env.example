# pr-gate site configuration: copy to ~/.config/jeryu/pr-gate.env on the gate host (mode 0600) and
# fill in. Every value that names a particular site lives here, never in ops/pr-gate.
#
# Format: KEY=VALUE lines, read as data and never run as shell. Blank lines and # comments are ignored;
# one pair of surrounding quotes is stripped; nothing is expanded except a leading "~/" (the gate
# user's home). Only PR_GATE_*, GATE_RUNNER_*, GATE_INSTALL_* and JERYU_* keys are read. A variable set
# in the environment (a systemd Environment= line, a drop-in) wins over this file, so a per-slot
# drop-in such as `Environment=GATE_RUNNER_OWNERS=acme` still narrows one slot.
# Lists are space-separated words. A relative path is under the gate user's home.

# --- forge and identity (required) ------------------------------------------------------------------
# The forge every request goes to. The heartbeat and wake scripts refuse any other JERYU_BASE.
PR_GATE_FORGE_URL=https://forge.example.test
# The gate identity's bearer token: a regular mode-0600 file.
JERYU_TOKEN_FILE=~/.config/jeryu/credentials/gate-bot.token
# The login that token belongs to. The runner never proves a head that identity authored.
GATE_RUNNER_IDENTITY=gate-bot

# --- what is gated ------------------------------------------------------------------------------------
# Owners whose protected repositories are discovered and gated (or pin GATE_RUNNER_REPOS=owner/repo ...).
GATE_RUNNER_OWNERS=acme tools
# The owner a bare repository name means, and whose mirrors and tree keep the unsuffixed paths
# (~/gate-runner/mirror, ~/gate-runner/tree); every other owner gets mirror/<owner> and tree-<owner>.
PR_GATE_PRIMARY_OWNER=acme
# Where each owner's canonical checkouts live (used to discover its family): explicit owner=path
# entries first, else the pattern with {owner} replaced.
PR_GATE_CHECKOUT_ROOTS=acme=src/acme
PR_GATE_CHECKOUT_ROOT_PATTERN=src/{owner}-checkouts
# Repositories whose required context is not <repo>/required: owner/repo=context.
PR_GATE_CONTEXT_OVERRIDES=tools/hub-db=hub/required

# --- contributed pull requests ---------------------------------------------------------------------
# A PR carrying this label on jeryu's own pull request row is an outside contribution: it is never
# executed until a maintainer allows its exact head, and then only inside the sandbox below. Default:
# origin:contributed, the marking jeryu-deploy's importer sets (every other row reads origin:internal).
PR_GATE_CONTRIBUTED_LABEL=origin:contributed
# The label a maintainer applies to allow one head (default ok-to-test), and the logins (space-
# separated words, globs) whose allowance the runner accepts. With no maintainer configured, no
# contribution is ever executed.
PR_GATE_OK_TO_TEST_LABEL=ok-to-test
PR_GATE_OK_TO_TEST_MAINTAINERS=dana robin
# The sandbox every allowed contribution runs in, called as
#   <command> <tree-root> <repo> <recipe...>
# It must put <tree-root> in an ephemeral, network-restricted VM or container at that same path, enter
# <repo> there and run the recipe. The runner gives it no forge token, no gate identity, no HOME or
# USER of the gate user, no governed tools and no shared cache; the guest's own isolation is what the
# command provides. Unset: no contribution is executed at all.
PR_GATE_SANDBOX_COMMAND=/usr/local/libexec/jeryu/gate-sandbox
# The PATH that command itself gets (default /usr/local/bin:/usr/bin:/bin). Never the gate's governed
# tools: they live in the gate user's home, which no contribution may read.
#PR_GATE_SANDBOX_PATH=/usr/local/bin:/usr/bin:/bin
# Paths (globs, as git reports them) whose change alters what the gate evaluates with. A contribution
# that changes one is recorded in its receipt and named on its check run, for review beyond the gate.
#PR_GATE_GATE_INPUT_PATHS=ops/ci/* ops/ci-kit/* ops/pr-gate/* .jeryu/ci.toml Justfile justfile .github/workflows/* .forgejo/workflows/* .gitea/workflows/*

# --- per-repository needs (all optional) ---------------------------------------------------------------
# Owners whose family tree gets ~/gate-runner/runtime-tools at <tree>/target/runtime-tools.
PR_GATE_RUNTIME_TOOLS_OWNERS=acme
# A prebuilt native vendor tree, linked at <repo>/target/native-vendor for the listed repositories
# (repo or owner/repo, globs) and hashed into the gate inputs of the second list.
GATE_RUNNER_NATIVE_VENDOR=src/acme/acme-deploy/target/native-vendor
PR_GATE_NATIVE_VENDOR_REPOS=acme-deploy acme-web
PR_GATE_NATIVE_VENDOR_INPUT_REPOS=acme-deploy
# Repositories outside a family that its gates read by exact tag/commit/tree, kept as a bare
# <name>.git in that family's tree: <tree-owner>=<owner>/<name>, space-separated.
PR_GATE_EVIDENCE_REPOS=acme=acme-labs/acme-evidence
# Repositories (owner/repo, globs) whose recipe must run at its physical slot path, never inside the
# private canonical-path mount namespace (their tests ask the host's service manager about paths).
PR_GATE_PHYSICAL_PATH_REPOS=acme/acme-ops
# Environment variables the recipe gets, each set to the root of its family tree.
PR_GATE_WORKER_ROOT_VARS=ACME_SPLIT_ROOT
# Cargo.lock source prefixes, besides crates.io, the locked-crate prefetch may fetch online.
PR_GATE_LOCK_SOURCES=git+https://forge.example.test/ git+http://127.0.0.1:8787/git/tools/
# Repositories (owner/repo or repo, globs) that share one build directory across slots (opt in).
#GATE_RUNNER_SHARED_TARGETS=

# --- waking a slot ------------------------------------------------------------------------------------
# Seconds pr-gate-wake.sh holds the forge's `gate-wanted` signal open while there is nothing to
# report. Longer than a slot's own timer period, so a waiting host is woken by a signal rather than by
# its own timeout, and inside the wake unit's TimeoutStartSec. A forge without the signal is read the
# way it was before the signal existed, so this changes nothing there.
#GATE_RUNNER_WAKE_WAIT=30

# --- heartbeat and installer ---------------------------------------------------------------------------
# The forge repository the installed code comes from, reported as the heartbeat's code.repo.
PR_GATE_CODE_REPO=tools/ci-runner
# Where pr-gate-install.sh fetches the gate from: a repository, its branch, and the component's path.
PR_GATE_SOURCE_URL=https://forge.example.test/git/tools/ci-runner.git
PR_GATE_SOURCE_BRANCH=main
PR_GATE_SOURCE_SUBDIR=ops/pr-gate
# The host's governed jankurai, recorded in tools.json as jankurai@governed.
#PR_GATE_GOVERNED_JANKURAI=/usr/local/libexec/jankurai
