#!/usr/bin/env bash
# Notify site-owned routing about a failed pr-redteam unit. The repository ships
# no host, channel or token; site.env may provide NOTIFY_COMMAND or NOTIFY_WEBHOOK_URL.
set -euo pipefail

unit="${1:-}"
[ -n "$unit" ] || { echo "pr-redteam notify: missing unit name" >&2; exit 1; }
case "$unit" in
  pr-redteam.service|pr-redteam-heartbeat.service|pr-redteam-poke.service) ;;
  *) echo "pr-redteam notify: refusing unexpected unit $unit" >&2; exit 1 ;;
esac

lines="${NOTIFY_JOURNAL_LINES:-80}"
[[ "$lines" =~ ^[0-9]+$ ]] || lines=80
max_body_bytes="${NOTIFY_MAX_BODY_BYTES:-8192}"
[[ "$max_body_bytes" =~ ^[1-9][0-9]*$ ]] || max_body_bytes=8192

tmp="$(mktemp -d "${TMPDIR:-/tmp}/pr-redteam-notify.XXXXXX")"
trap 'rm -rf -- "$tmp"' EXIT
body_file="$tmp/body.txt"
full_body_file="$tmp/body-full.txt"
journal_file="$tmp/journal.txt"
payload_file="$tmp/payload.json"

forbidden_token_values() {
  local name path value
  for name in JERYU_TOKEN_FILE REDTEAM_MERGE_TOKEN_FILE; do
    path="${!name:-}"
    [[ -n "$path" && -f "$path" && ! -L "$path" && -r "$path" ]] || continue
    value="$(cat -- "$path" 2>/dev/null || true)"
    [[ -n "$value" ]] || continue
    printf '%s\n' "$value"
  done
  for name in NOTIFY_WEBHOOK_URL ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN; do
    value="${!name:-}"
    [[ -n "$value" ]] || continue
    printf '%s\n' "$value"
  done
}

subject="pr-redteam unit failed: $unit"
journalctl --user -u "$unit" -n "$lines" --no-pager -o short-iso >"$journal_file" 2>&1 || true
{
  printf '%s\n\nlast %s journal lines:\n' "$subject" "$lines"
  cat "$journal_file"
  printf '\n'
} >"$full_body_file"
head -c "$max_body_bytes" "$full_body_file" >"$body_file"

validate_capture_text() {
  local label="$1" file="$2" text token encoded hex squeezed
  text="$(cat -- "$file")"
  squeezed="$(printf '%s' "$text" | tr -d '[:space:]')"
  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    encoded="$(printf '%s' "$token" | base64 -w0)"
    hex="$(printf '%s' "$token" | od -An -tx1 | tr -d ' \n')"
    if [[ "$text" == *"$token"* ||
          "$text" == *"$encoded"* ||
          "$text" == *"$hex"* ||
          "$squeezed" == *"$token"* ]]; then
      printf 'pr-redteam notify: configured token value appeared in %s; omitting journal body\n' \
        "$label" >&2
      return 1
    fi
  done < <(forbidden_token_values)
}

if ! validate_capture_text notification "$body_file"; then
  printf '%s\n\njournal omitted: configured token value appeared in captured output.\n' \
    "$subject" >"$body_file"
fi

if [ -n "${NOTIFY_COMMAND:-}" ]; then
  export PR_REDTEAM_FAILED_UNIT="$unit"
  export PR_REDTEAM_NOTIFY_SUBJECT="$subject"
  export PR_REDTEAM_NOTIFY_BODY_FILE="$body_file"
  sh -c "$NOTIFY_COMMAND" <"$body_file"
  exit 0
fi

if [ -n "${NOTIFY_WEBHOOK_URL:-}" ]; then
  command -v curl >/dev/null || { echo "pr-redteam notify: curl is required for NOTIFY_WEBHOOK_URL" >&2; exit 1; }
  jq -n --arg unit "$unit" --arg subject "$subject" --rawfile body "$body_file" \
    '{source:"pr-redteam", unit:$unit, subject:$subject, body:$body}' >"$payload_file"
  curl --fail --silent --show-error --request POST \
    --header 'Content-Type: application/json' \
    --data-binary "@$payload_file" \
    "$NOTIFY_WEBHOOK_URL" >/dev/null
  exit 0
fi

echo "pr-redteam notify: no NOTIFY_COMMAND or NOTIFY_WEBHOOK_URL configured for $unit" >&2
exit 0
