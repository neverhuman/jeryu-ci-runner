# Tell jeryu's /runners page that this reviewer is alive, and what it is reviewing right now. One
# cheap POST per start; pr-redteam-heartbeat.timer starts it every minute because the server forgets
# a runner after 180s while a review pass only runs every five minutes. It never reviews or merges.
[Unit]
Description=pr-redteam: report runner liveness to jeryu
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# The forge origin and the approver credential path are site configuration, not
# source: set JERYU_BASE and JERYU_TOKEN_FILE in this file. Without it the unit
# refuses to run rather than guessing one installation's forge.
EnvironmentFile=%h/.config/pr-redteam/site.env
ExecStart=@REDTEAM_DIR@/pr-redteam heartbeat
Nice=15
TimeoutStartSec=2min
