      "description": "Produced by guest Git, after checking the bundle refs and successful rebase.",
      "type": "object",
      "properties": {
        "head_revision": {
          "type": "string"
        },
        "main_revision": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        },
