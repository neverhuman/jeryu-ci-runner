        "main_revision",
        "head_revision",
        "sync_state"
      ]
    },
    "WorkspaceSource": {
      "oneOf": [
        {
          "description": "Model-free empty-disk fixture only. Never a repository readiness receipt.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "empty-fixture"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "base_revision": {
              "description": "Base of retained work. The source head is bound in SessionContext.",
              "type": "string"
            },
            "bundle": {
              "$ref": "#/$defs/ArtifactIdentity"
            },
            "bundle_bytes": {
              "description": "Exact bundle length, excluding block-device alignment padding.",
              "type": "integer",
              "format": "uint64",
              "maximum": 1073741824,
              "minimum": 1
            },
            "kind": {
              "type": "string",
              "const": "git-bundle"
            },
            "main_revision": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "bundle",
            "bundle_bytes",
            "main_revision",
            "base_revision"
          ]
        }
      ]
    },
    "WorkspaceSyncState": {
      "type": "string",
      "enum": [
        "ready",
        "rebase-required"
      ]
    }
