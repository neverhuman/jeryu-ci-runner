# Cargo Git transport overlay. The Cargo source identity remains the historical
# immutable URL; this exact rewrite moves only the network destination to the
# private hosted forge without creating a second crate identity.
[credential]
	helper =

[credential "https://git.neverhuman.org"]
	helper = /home/ubuntu/.config/jeryu/bin/git-credential-neverhuman-org

# The current hosted smart-HTTP service rejects Git's compressed upload-pack
# request body. Keep this setting host-scoped until the service is repaired.
[http "https://git.neverhuman.org"]
	postBuffer = 1

# Git 2.43 aborts (remote-curl.c "rpc->buf should be larger than
# LARGE_PACKET_MAX") when a protocol v2 command request meets postBuffer = 1,
# and the hosted service now advertises v2. Pin the v0 exchange, whose
# ref advertisement needs no request body. Only this overlay's Git children see it.
[protocol]
	version = 0

[url "https://git.neverhuman.org/git/jeryu/jeryu-core.git"]
	insteadOf = https://github.com/neverhuman/jeryu-core.git
