# Cargo Git transport overlay. The Cargo source identity remains the historical
# immutable URL; this exact rewrite moves only the network destination to the
# private hosted forge without creating a second crate identity.
[credential]
	helper =

[credential "https://git.neverhuman.org"]
	helper = /home/ubuntu/.config/jeryu/bin/git-credential-neverhuman-org

# No http.postBuffer here on purpose. A host-scoped postBuffer = 1 used to sit
# in this overlay for a smart-HTTP defect the hosted service no longer has: it
# accepts gzip upload-pack bodies. With protocol v2 advertised, that setting
# makes Git 2.43 abort in remote-curl.c ("rpc->buf should be larger than
# LARGE_PACKET_MAX"), so the overlay keeps Git's defaults and protocol v2.

[url "https://git.neverhuman.org/git/jeryu/jeryu-core.git"]
	insteadOf = https://github.com/neverhuman/jeryu-core.git
